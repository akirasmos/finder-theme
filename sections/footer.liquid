{% comment %}
  Footer, as a bottom drawer rather than a scrolling page region — the
  window stays one persistent, full-viewport surface. Opened from the
  status bar's tagline/info control (see finder-statusbar.liquid).
{% endcomment %}
<div class="footer-drawer" data-footer-drawer hidden>
  <div class="footer-drawer__backdrop" data-footer-backdrop></div>
  <div class="footer-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ section.settings.heading }}">
    <button type="button" class="footer-drawer__close icon-btn" data-footer-close aria-label="{{ 'general.accessibility.close' | t }}">
      {% render 'icon', name: 'close' %}
    </button>

    <div class="footer-drawer__content">
      <h2 class="footer-drawer__heading">{{ section.settings.heading }}</h2>

      {%- if section.settings.about_text != blank -%}
        <div class="rte footer-drawer__about">{{ section.settings.about_text }}</div>
      {%- endif -%}

      {%- assign has_links = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'link' -%}{%- assign has_links = true -%}{%- endif -%}
      {%- endfor -%}

      {%- if has_links -%}
        <ul class="footer-drawer__links">
          {%- for block in section.blocks -%}
            {%- if block.type == 'link' -%}
              <li>
                <a href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.instagram_url != blank or section.settings.tiktok_url != blank -%}
        <div class="footer-drawer__social">
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" class="icon-btn" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>
          {%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}
            <a href="{{ section.settings.tiktok_url }}" class="icon-btn" aria-label="TikTok">{% render 'icon', name: 'tiktok' %}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <p class="footer-drawer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.copyright_extra != blank %} &mdash; {{ section.settings.copyright_extra }}{% endif %}
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.footer.settings.heading.label",
      "default": "About standard.zip"
    },
    {
      "type": "richtext",
      "id": "about_text",
      "label": "t:sections.footer.settings.about_text.label",
      "default": "<p>Small-batch garments, shipped worldwide. Questions? We read every email.</p>"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "t:sections.footer.settings.instagram_url.label"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "t:sections.footer.settings.tiktok_url.label"
    },
    {
      "type": "text",
      "id": "copyright_extra",
      "label": "t:sections.footer.settings.copyright_extra.label",
      "info": "t:sections.footer.settings.copyright_extra.info"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "t:sections.footer.blocks.link.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.footer.blocks.link.settings.label.label"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:sections.footer.blocks.link.settings.url.label"
        }
      ]
    }
  ]
}
{% endschema %}
