{% comment %}
  Global left rail: Finder "Favorites" (collections) + "Locations"
  (internal navigation shortcuts, e.g. the Bag). Block-based so a
  merchant can add/reorder/relabel entries and assign a per-item icon
  from the theme's icon set.
{% endcomment %}
<nav class="finder-sidebar" id="FinderSidebar" aria-label="{{ 'general.sidebar.favorites' | t }}">
  {%- assign has_favorites = false -%}
  {%- assign has_locations = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'favorite_link' -%}{%- assign has_favorites = true -%}{%- endif -%}
    {%- if block.type == 'location_link' -%}{%- assign has_locations = true -%}{%- endif -%}
  {%- endfor -%}

  {%- if has_favorites -%}
    <div class="finder-sidebar__section">
      <h2 class="finder-sidebar__heading">{{ section.settings.favorites_heading }}</h2>
      <ul class="finder-sidebar__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'favorite_link' -%}
            {%- liquid
              assign link_collection = block.settings.collection
              assign link_url = link_collection.url | default: '#'
              assign link_label = block.settings.label | default: link_collection.title | default: 'Untitled'
              assign is_current = false
              if link_collection and request.path == link_collection.url
                assign is_current = true
              endif
            -%}
            <li>
              <a
                href="{{ link_url }}"
                class="finder-sidebar__item"
                {% if is_current %}aria-current="page"{% endif %}
                {{ block.shopify_attributes }}
              >
                {% render 'icon', name: block.settings.icon %}
                <span>{{ link_label }}</span>
                {%- if block.settings.show_count and link_collection -%}
                  <span class="finder-sidebar__count">{{ link_collection.products_count }}</span>
                {%- endif -%}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  {%- if has_locations -%}
    <div class="finder-sidebar__section">
      <h2 class="finder-sidebar__heading">{{ section.settings.locations_heading }}</h2>
      <ul class="finder-sidebar__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'location_link' -%}
            {%- liquid
              assign loc_url = block.settings.url | default: '#'
              assign is_current = false
              if loc_url != '#' and request.path == loc_url
                assign is_current = true
              endif
            -%}
            <li>
              <a
                href="{{ loc_url }}"
                class="finder-sidebar__item"
                {% if is_current %}aria-current="page"{% endif %}
                {% if block.settings.show_cart_count %}data-cart-count-container data-cart-count-class="finder-sidebar__count"{% endif %}
                {{ block.shopify_attributes }}
              >
                {% render 'icon', name: block.settings.icon %}
                <span>{{ block.settings.label }}</span>
                {%- if block.settings.show_cart_count and cart.item_count > 0 -%}
                  <span class="finder-sidebar__count" data-cart-count>{{ cart.item_count }}</span>
                {%- endif -%}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</nav>
<div class="finder-sidebar-backdrop" data-sidebar-backdrop hidden></div>

{% schema %}
{
  "name": "t:sections.finder_sidebar.name",
  "settings": [
    {
      "type": "text",
      "id": "favorites_heading",
      "label": "t:sections.finder_sidebar.settings.favorites_heading.label",
      "default": "Favorites"
    },
    {
      "type": "text",
      "id": "locations_heading",
      "label": "t:sections.finder_sidebar.settings.locations_heading.label",
      "default": "Locations"
    }
  ],
  "blocks": [
    {
      "type": "favorite_link",
      "name": "t:sections.finder_sidebar.blocks.favorite_link.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.finder_sidebar.blocks.favorite_link.settings.collection.label"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.finder_sidebar.blocks.favorite_link.settings.label.label",
          "info": "t:sections.finder_sidebar.blocks.favorite_link.settings.label.info"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.finder_sidebar.blocks.favorite_link.settings.icon.label",
          "options": [
            { "value": "folder", "label": "Folder" },
            { "value": "shirt", "label": "Shirt" },
            { "value": "pants", "label": "Pants" },
            { "value": "jacket", "label": "Jacket" },
            { "value": "bag-accessory", "label": "Bag" },
            { "value": "percent", "label": "Percent" },
            { "value": "tag", "label": "Tag" },
            { "value": "clock", "label": "Clock" },
            { "value": "grid", "label": "Grid" }
          ],
          "default": "folder"
        },
        {
          "type": "checkbox",
          "id": "show_count",
          "label": "t:sections.finder_sidebar.blocks.favorite_link.settings.show_count.label",
          "default": true
        }
      ]
    },
    {
      "type": "location_link",
      "name": "t:sections.finder_sidebar.blocks.location_link.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.finder_sidebar.blocks.location_link.settings.label.label"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:sections.finder_sidebar.blocks.location_link.settings.url.label",
          "info": "t:sections.finder_sidebar.blocks.location_link.settings.url.info"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.finder_sidebar.blocks.location_link.settings.icon.label",
          "options": [
            { "value": "bag", "label": "Bag" },
            { "value": "folder", "label": "Folder" },
            { "value": "file", "label": "File" },
            { "value": "tag", "label": "Tag" },
            { "value": "info", "label": "Info" },
            { "value": "image", "label": "Image" }
          ],
          "default": "bag"
        },
        {
          "type": "checkbox",
          "id": "show_cart_count",
          "label": "t:sections.finder_sidebar.blocks.location_link.settings.show_cart_count.label",
          "info": "t:sections.finder_sidebar.blocks.location_link.settings.show_cart_count.info",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
