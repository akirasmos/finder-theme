{% comment %}
  Search results — scoped to products so results stay shaped for the
  file-icon grid (price/color/size), same real filtering/sorting as the
  collection template.
{% endcomment %}
<div class="collection-main">
  {%- paginate search.results by section.settings.products_per_page -%}
    {%- if search.performed -%}
      <div class="collection-toolbar">
        {% render 'facets', results: search, results_url: routes.search_url, preserve_query: search.terms %}
      </div>
    {%- endif -%}

    {%- if search.performed == false -%}
      {%- liquid
        assign prompt_title = 'general.search.prompt_title' | t
      -%}
      {% render 'empty-state', icon: 'search', title: prompt_title %}
    {%- elsif search.results.size == 0 -%}
      {%- liquid
        assign empty_title = 'general.search.no_results' | t
        assign empty_description = 'general.search.no_results_description' | t
      -%}
      {% render 'empty-state', icon: 'search', title: empty_title, description: empty_description %}
    {%- else -%}
      <div class="file-browser" data-view-target data-view="{{ settings.default_view | default: 'icon' }}">
        <div class="file-list__header" data-view-header aria-hidden="true">
          <span></span>
          <span>{{ 'products.collection.column_name' | t }}</span>
          <span>{{ 'products.collection.column_price' | t }}</span>
          <span>{{ 'products.collection.column_color' | t }}</span>
          <span>{{ 'products.collection.column_size' | t }}</span>
        </div>
        <ul class="file-grid" role="list">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-file-icon', product: item %}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "t:sections.main_search.name",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:sections.main_search.settings.products_per_page.label",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}
