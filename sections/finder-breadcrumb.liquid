{% comment %}
  Global path bar: a real, clickable breadcrumb trail (not a title-bar
  echo). On listing templates it also carries the grid/list view switch,
  mirroring Finder's toolbar view segmented control.
{% endcomment %}
{%- liquid
  assign root_title = section.settings.window_title | default: 'standard.zip'
  assign is_listing = false
  if template.name == 'collection' or template.name == 'search'
    assign is_listing = true
  endif
  assign default_view = settings.default_view | default: 'icon'
-%}
<div class="finder-breadcrumb">
  <ol class="finder-breadcrumb__list">
    <li class="finder-breadcrumb__item" {% if template.name == 'index' %}aria-current="page"{% endif %}>
      <a href="{{ routes.root_url }}" class="finder-breadcrumb__link">
        {% render 'icon', name: 'folder' %}
        <span>{{ root_title }}</span>
      </a>
    </li>

    {%- case template.name -%}
      {%- when 'product' -%}
        {%- if product.type != blank -%}
          <li class="finder-breadcrumb__item">
            {% render 'icon', name: 'chevron-right', class: 'finder-breadcrumb__chevron' %}
            <a href="{{ routes.all_products_collection_url }}?filter.p.product_type={{ product.type | url_param_escape }}" class="finder-breadcrumb__link">{{ product.type }}</a>
          </li>
        {%- endif -%}
        <li class="finder-breadcrumb__item" aria-current="page">
          {% render 'icon', name: 'chevron-right', class: 'finder-breadcrumb__chevron' %}
          <span class="finder-breadcrumb__link">{{ product.title }}</span>
        </li>
      {%- when 'collection' -%}
        <li class="finder-breadcrumb__item" aria-current="page">
          {% render 'icon', name: 'chevron-right', class: 'finder-breadcrumb__chevron' %}
          <span class="finder-breadcrumb__link">{{ collection.title }}</span>
        </li>
      {%- when 'search' -%}
        <li class="finder-breadcrumb__item" aria-current="page">
          {% render 'icon', name: 'chevron-right', class: 'finder-breadcrumb__chevron' %}
          <span class="finder-breadcrumb__link">
            {%- if search.performed and search.terms != blank -%}
              {{ 'general.search.results_for' | t: terms: search.terms }}
            {%- else -%}
              {{ 'general.search.label' | t }}
            {%- endif -%}
          </span>
        </li>
      {%- when 'cart' -%}
        <li class="finder-breadcrumb__item" aria-current="page">
          {% render 'icon', name: 'chevron-right', class: 'finder-breadcrumb__chevron' %}
          <span class="finder-breadcrumb__link">{{ 'general.cart.title' | t }}</span>
        </li>
      {%- when 'page' -%}
        <li class="finder-breadcrumb__item" aria-current="page">
          {% render 'icon', name: 'chevron-right', class: 'finder-breadcrumb__chevron' %}
          <span class="finder-breadcrumb__link">{{ page.title }}</span>
        </li>
      {%- when '404' -%}
        <li class="finder-breadcrumb__item" aria-current="page">
          {% render 'icon', name: 'chevron-right', class: 'finder-breadcrumb__chevron' %}
          <span class="finder-breadcrumb__link">{{ 'general.not_found.title' | t }}</span>
        </li>
    {%- endcase -%}
  </ol>

  {%- if is_listing -%}
    <div class="finder-breadcrumb__extra">
      <div class="view-toggle" role="group" aria-label="{{ 'general.view.toggle_label' | t }}">
        <button type="button" data-view-toggle="icon" aria-pressed="{% if default_view == 'icon' %}true{% else %}false{% endif %}">
          {% render 'icon', name: 'grid' %}
          <span class="visually-hidden">{{ 'general.view.icon_view' | t }}</span>
        </button>
        <button type="button" data-view-toggle="list" aria-pressed="{% if default_view == 'list' %}true{% else %}false{% endif %}">
          {% render 'icon', name: 'list' %}
          <span class="visually-hidden">{{ 'general.view.list_view' | t }}</span>
        </button>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.finder_breadcrumb.name",
  "settings": [
    {
      "type": "text",
      "id": "window_title",
      "label": "t:sections.finder_breadcrumb.settings.window_title.label",
      "default": "standard.zip",
      "info": "t:sections.finder_breadcrumb.settings.window_title.info"
    }
  ]
}
{% endschema %}
