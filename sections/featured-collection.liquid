{% comment %}
  Homepage product teaser — always icon view (the full grid/list toggle
  lives on the actual collection page, not this preview).
{% endcomment %}
<section class="featured-collection">
  <div class="featured-collection__header">
    <h2 class="featured-collection__heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.collection -%}
      <a href="{{ section.settings.collection.url }}" class="featured-collection__view-all">
        {{ section.settings.view_all_label }}
        {% render 'icon', name: 'chevron-right' %}
      </a>
    {%- endif -%}
  </div>

  {%- if section.settings.collection -%}
    <div class="file-browser" data-view="icon">
      <ul class="file-grid" role="list">
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {% render 'product-file-icon', product: product %}
        {%- endfor -%}
      </ul>
    </div>
  {%- else -%}
    {%- liquid
      assign empty_title = 'homepage.featured_collection.empty_title' | t
      assign empty_description = 'homepage.featured_collection.empty_description' | t
    -%}
    {% render 'empty-state',
      icon: 'folder',
      title: empty_title,
      description: empty_description
    %}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured_collection.settings.heading.label",
      "default": "New Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.featured_collection.settings.products_to_show.label",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 8
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:sections.featured_collection.settings.view_all_label.label",
      "default": "View All"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.name"
    }
  ]
}
{% endschema %}
