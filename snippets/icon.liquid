{% comment %}
  Single icon system for the whole theme — one stroke weight (1.5), one
  22x22 viewport, currentColor. Never mix in a different icon set.
  Usage: {% render 'icon', name: 'folder' %}
{% endcomment %}
{%- liquid
  assign icon_name = name | default: 'folder'
  assign icon_class = 'icon icon--' | append: icon_name
  if class
    assign icon_class = icon_class | append: ' ' | append: class
  endif
-%}
<svg class="{{ icon_class }}" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  {%- case icon_name -%}
    {%- when 'folder' -%}
      <path d="M3 6.2C3 5.5 3.5 5 4.2 5h4.4l1.8 2h7.4c.7 0 1.2.5 1.2 1.2v7.6c0 .7-.5 1.2-1.2 1.2H4.2c-.7 0-1.2-.5-1.2-1.2V6.2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    {%- when 'tag' -%}
      <path d="M11.5 3.5h4.7c.7 0 1.3.6 1.3 1.3v4.7c0 .4-.1.7-.4 1l-7.4 7.4c-.5.5-1.4.5-2 0l-4-4c-.5-.5-.5-1.4 0-2l7.4-7.4c.3-.3.6-.4 1-.4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <circle cx="14.2" cy="7.8" r="1" fill="currentColor"/>
    {%- when 'percent' -%}
      <circle cx="6.5" cy="6.5" r="2.2" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="15.5" cy="15.5" r="2.2" stroke="currentColor" stroke-width="1.5"/>
      <path d="M16 4L4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'shirt' -%}
      <path d="M8 3l3 1.6L14 3l3 2.6-2 2.4v10H7v-10L5 5.6 8 3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    {%- when 'pants' -%}
      <path d="M6 3h10l.6 15-3.3.3L11 9.5 8.7 18.3 5.4 18 6 3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    {%- when 'jacket' -%}
      <path d="M7.5 3L11 4.6 14.5 3 18 5.8l-2.2 2.4.7 9.8H5.5l.7-9.8L4 5.8 7.5 3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M11 4.6v13.4" stroke="currentColor" stroke-width="1.5"/>
    {%- when 'bag-accessory' -%}
      <path d="M6.5 8.5h9l.7 9.5a1.2 1.2 0 0 1-1.2 1.3H7a1.2 1.2 0 0 1-1.2-1.3l.7-9.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M8.5 8.5V7a2.5 2.5 0 0 1 5 0v1.5" stroke="currentColor" stroke-width="1.5"/>
    {%- when 'search' -%}
      <circle cx="9.5" cy="9.5" r="5.5" stroke="currentColor" stroke-width="1.5"/>
      <path d="M17 17l-3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'bag' -%}
      <path d="M5.5 8h11l.9 10.2a1.3 1.3 0 0 1-1.3 1.4H5.9a1.3 1.3 0 0 1-1.3-1.4L5.5 8z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M8 8V6.5a3 3 0 0 1 6 0V8" stroke="currentColor" stroke-width="1.5"/>
    {%- when 'grid' -%}
      <rect x="3.5" y="3.5" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/>
      <rect x="12.5" y="3.5" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/>
      <rect x="3.5" y="12.5" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/>
      <rect x="12.5" y="12.5" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/>
    {%- when 'chevron-right' -%}
      <path d="M8 4.5L14 11l-6 6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'chevron-down' -%}
      <path d="M4.5 8l6.5 6 6.5-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'sidebar' -%}
      <rect x="3" y="4" width="16" height="14" rx="1.6" stroke="currentColor" stroke-width="1.5"/>
      <path d="M8.5 4v14" stroke="currentColor" stroke-width="1.5"/>
    {%- when 'close' -%}
      <path d="M6 6l10 10M16 6L6 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'trash' -%}
      <path d="M5 6.5h12M9 6.5V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v1.5M8 6.5v11a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'check' -%}
      <path d="M4.5 11.5l4 4 9-9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'minus' -%}
      <path d="M5 11h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'plus' -%}
      <path d="M11 5v12M5 11h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'play' -%}
      <path d="M9 6.5l7 4.5-7 4.5v-9z" fill="currentColor"/>
    {%- when 'clock' -%}
      <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.5"/>
      <path d="M11 7v4.5l3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'image' -%}
      <rect x="3" y="4" width="16" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="8" cy="9" r="1.6" stroke="currentColor" stroke-width="1.5"/>
      <path d="M4.5 15.5l4.8-4.8a1.2 1.2 0 0 1 1.7 0l3.2 3.2 1.8-1.8a1.2 1.2 0 0 1 1.7 0l1.8 1.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'file' -%}
      <path d="M6.5 3.5h6l3 3v11.5a1 1 0 0 1-1 1h-8a1 1 0 0 1-1-1V4.5a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M12.5 3.5v3h3" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    {%- when 'info' -%}
      <circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.5"/>
      <path d="M11 10v5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="11" cy="7.2" r="0.9" fill="currentColor"/>
    {%- when 'instagram' -%}
      <rect x="3.5" y="3.5" width="15" height="15" rx="4.5" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="11" cy="11" r="4" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="15.3" cy="6.7" r="1" fill="currentColor"/>
    {%- when 'tiktok' -%}
      <path d="M12.5 3v10.6a2.8 2.8 0 1 1-2.4-2.77" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M12.5 3c.3 2.5 2 4.3 4.5 4.6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'alert' -%}
      <path d="M11 3.5l8.5 15h-17L11 3.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M11 9v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="11" cy="15.6" r="0.9" fill="currentColor"/>
  {%- endcase -%}
</svg>
