{% comment %}
  Usage: {% render 'cart-item', item: item, line_index: forloop.index %}
{% endcomment %}
{%- liquid
  assign filename = item.product.title | handleize | append: '.png'
-%}
<li class="bag-item" data-cart-item data-cart-item-key="{{ item.key }}">
  <a href="{{ item.url }}" class="bag-item__media" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      <img
        src="{{ item.image | image_url: width: 160 }}"
        srcset="{{ item.image | image_url: width: 80 }} 80w, {{ item.image | image_url: width: 160 }} 160w"
        sizes="56px"
        width="{{ item.image.width }}"
        height="{{ item.image.height }}"
        alt=""
        loading="lazy"
      >
    {%- else -%}
      <span class="bag-item__placeholder">{% render 'icon', name: 'file' %}</span>
    {%- endif -%}
  </a>

  <div class="bag-item__info">
    <a href="{{ item.url }}" class="bag-item__name">{{ filename }}</a>
    {%- if item.variant.title != 'Default Title' -%}
      <p class="bag-item__variant">{{ item.variant.title }}</p>
    {%- endif -%}
    {%- unless item.variant.available -%}
      <p class="bag-item__unavailable">{{ 'general.cart.unavailable' | t }}</p>
    {%- endunless -%}
  </div>

  <div class="bag-item__quantity">
    <div class="quantity-input quantity-input--sm">
      <button type="button" class="quantity-input__button" data-cart-quantity-decrease aria-label="{{ 'products.product.quantity_decrease' | t }}">
        {% render 'icon', name: 'minus' %}
      </button>
      <input
        type="number"
        class="quantity-input__field"
        name="updates[]"
        value="{{ item.quantity }}"
        min="0"
        aria-label="{{ 'products.product.quantity' | t }}: {{ filename }}"
        data-cart-quantity-input
        data-line="{{ line_index }}"
      >
      <button type="button" class="quantity-input__button" data-cart-quantity-increase aria-label="{{ 'products.product.quantity_increase' | t }}">
        {% render 'icon', name: 'plus' %}
      </button>
    </div>
  </div>

  <div class="bag-item__price" data-cart-item-price>{{ item.final_line_price | money }}</div>

  <button type="button" class="bag-item__remove" data-cart-remove aria-label="{{ 'general.cart.remove' | t }}: {{ filename }}">
    {% render 'icon', name: 'trash' %}
  </button>
</li>
